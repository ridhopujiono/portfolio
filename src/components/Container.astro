---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  width?: 'default' | 'narrow';
}

const { width = 'default', class: className, ...attributes } = Astro.props;
---

<div {...attributes} class:list={['container', { 'container--narrow': width === 'narrow' }, className]}>
  <slot />
</div>

<style>
  .container {
    --container-width: var(--container-main);
    inline-size: 100%;
    max-inline-size: calc(var(--container-width) + var(--spacing-gutter) * 2);
    min-inline-size: 0;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .container--narrow {
    --container-width: var(--container-narrow);
  }
</style>
