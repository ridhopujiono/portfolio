---
import Container from './Container.astro';
import Section from './Section.astro';
import Badge from './Badge.astro';
import { withBase } from '../lib/urls';
import type { Project } from '../lib/projects';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
  headings: { depth: number; slug: string; text: string }[];
  meta: {
    type: string;
    company?: string;
    client?: string;
    role: string;
    status: string;
    periods?: { label: string; period: string }[];
  };
}

const { project, headings, meta } = Astro.props;
const { data } = project;

const h2Headings = headings.filter(h => h.depth === 2);
---

<Section class="project-detail">
  <Container>
    <div class="project-detail__breadcrumb type-small">
      <a href={withBase('/')}>Home</a>
      <span class="separator" aria-hidden="true">/</span>
      <a href={withBase('/projects/')}>Projects</a>
      <span class="separator" aria-hidden="true">/</span>
      <span class="current" aria-current="page">{data.title}</span>
    </div>

    <header class="project-detail__header">
      <h1 class="type-display project-detail__title">{data.title}</h1>
      <p class="type-body project-detail__summary">{data.summary}</p>
    </header>

    {data.previews && data.previews.length > 0 && (
      <>
        <div class="project-gallery" aria-label="Project previews">
          {data.previews.map((preview) => (
            <figure class="gallery-item">
              <button type="button" class="lightbox-trigger" aria-label={`View larger: ${preview.alt}`} data-image-src={preview.src.src} data-image-alt={preview.alt}>
                <Image src={preview.src} alt={preview.alt} class="gallery-image" width={800} />
                <div class="lightbox-overlay" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                </div>
              </button>
              <figcaption class="gallery-caption type-small">{preview.alt}</figcaption>
            </figure>
          ))}
        </div>

        <dialog id="image-lightbox" class="lightbox">
          <button type="button" class="lightbox-close" aria-label="Close modal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
          <div class="lightbox-content">
            <img src="" alt="" id="lightbox-img" loading="lazy" />
            <p id="lightbox-caption" class="type-body"></p>
          </div>
        </dialog>
      </>
    )}

    <div class="project-detail__layout">
      <div class="project-detail__metadata-area">
        <div class="metadata-grid">
          <div class="metadata-item">
            <h3 class="type-small metadata-label">Project Type</h3>
            <p class="type-body metadata-value">{meta.type}</p>
          </div>
          
          {meta.company && (
            <div class="metadata-item">
              <h3 class="type-small metadata-label">Company</h3>
              <p class="type-body metadata-value">{meta.company}</p>
            </div>
          )}

          {meta.client && (
            <div class="metadata-item">
              <h3 class="type-small metadata-label">Client</h3>
              <p class="type-body metadata-value">{meta.client}</p>
            </div>
          )}

          {meta.role && (
            <div class="metadata-item">
              <h3 class="type-small metadata-label">Role</h3>
              <p class="type-body metadata-value">{meta.role}</p>
            </div>
          )}

          <div class="metadata-item">
            <h3 class="type-small metadata-label">System Status</h3>
            <p class="type-body metadata-value">{meta.status}</p>
          </div>
          
          {meta.periods && meta.periods.map(p => (
            <div class="metadata-item">
              <h3 class="type-small metadata-label">{p.label}</h3>
              <p class="type-body metadata-value">{p.period}</p>
            </div>
          ))}

          {data.technologies.length > 0 && (
            <div class="metadata-item metadata-item--full">
              <h3 class="type-small metadata-label">Technologies</h3>
              <ul class="metadata-tech-list" role="list">
                {data.technologies.map(tech => (
                  <li><Badge>{tech}</Badge></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      <div class="project-detail__content-area">
        {h2Headings.length > 0 && (
          <nav class="toc" aria-label="Table of Contents">
            <h2 class="type-small toc-heading">In this case study</h2>
            <ul class="toc-list type-body" role="list">
              {h2Headings.map(heading => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="markdown-content">
          <slot />
        </div>
        
        <div class="project-detail__footer">
          <a href={withBase('/projects/')} class="back-link type-body">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Back to projects
          </a>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .project-detail {
    padding-block-start: calc(var(--spacing) * 6);
    padding-block-end: calc(var(--spacing) * 20);
  }

  .project-detail__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin-block-end: calc(var(--spacing) * 8);
    color: var(--color-text-muted);
  }

  .project-detail__breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .project-detail__breadcrumb a:hover {
    color: var(--color-text-primary);
  }

  .project-detail__breadcrumb .current {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .project-detail__header {
    margin-block-end: calc(var(--spacing) * 12);
  }

  .project-detail__title {
    color: var(--color-text-primary);
    margin-block-end: calc(var(--spacing) * 4);
  }

  .project-detail__summary {
    color: var(--color-text-secondary);
    max-inline-size: 65ch;
  }

  .project-detail__layout {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 12);
  }

  .project-gallery {
    display: flex;
    gap: calc(var(--spacing) * 4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block-end: calc(var(--spacing) * 4);
    margin-block-end: calc(var(--spacing) * 12);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-subtle) transparent;
  }

  .project-gallery::-webkit-scrollbar {
    height: 8px;
  }
  
  .project-gallery::-webkit-scrollbar-thumb {
    background-color: var(--color-border-subtle);
    border-radius: var(--radius-pill);
  }

  .gallery-item {
    flex: 0 0 85%;
    max-inline-size: 800px;
    scroll-snap-align: center;
    margin: 0;
  }
  
  @media (min-width: 48rem) {
    .gallery-item {
      flex: 0 0 70%;
    }
  }

  .gallery-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-surface);
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface);
    display: block;
  }
  
  .lightbox-trigger {
    position: relative;
    display: block;
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    cursor: zoom-in;
    border-radius: var(--radius-surface);
    overflow: hidden;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
    border-radius: var(--radius-surface);
  }

  .lightbox-trigger:hover .lightbox-overlay,
  .lightbox-trigger:focus-visible .lightbox-overlay {
    opacity: 1;
  }

  .lightbox-overlay svg {
    width: 2.5rem;
    height: 2.5rem;
    color: white;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }
  
  /* Lightbox Modal Styles */
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.95);
    border: none;
    color: white;
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.95);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox-close {
    position: absolute;
    top: calc(var(--spacing) * 4);
    right: calc(var(--spacing) * 4);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background-color var(--duration-fast);
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-close svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .lightbox-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--spacing) * 4);
    overflow: hidden;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: calc(100vh - 8rem);
    object-fit: contain;
  }

  #lightbox-caption {
    margin-top: calc(var(--spacing) * 4);
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
  }

  .gallery-caption {
    margin-block-start: calc(var(--spacing) * 3);
    color: var(--color-text-muted);
    text-align: center;
  }

  .metadata-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--spacing) * 6);
    padding: calc(var(--spacing) * 6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1);
  }
  
  .metadata-item--full {
    grid-column: 1 / -1;
    margin-block-start: calc(var(--spacing) * 4);
  }

  .metadata-label {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metadata-value {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .metadata-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2);
    margin-block-start: calc(var(--spacing) * 2);
  }

  .toc {
    margin-block-end: calc(var(--spacing) * 10);
    padding: calc(var(--spacing) * 6);
    background-color: var(--color-surface);
    border-radius: var(--radius-surface);
  }

  .toc-heading {
    margin-block-end: calc(var(--spacing) * 4);
    color: var(--color-text-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }

  .toc-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .toc-list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-detail__content-area {
    min-inline-size: 0;
  }

  .markdown-content {
    max-inline-size: 65ch;
  }

  .markdown-content :global(h2) {
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-block-start: calc(var(--spacing) * 12);
    margin-block-end: calc(var(--spacing) * 4);
    scroll-margin-top: calc(var(--site-header-height, 4rem) + 2rem);
  }

  .markdown-content :global(h3) {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-block-start: calc(var(--spacing) * 8);
    margin-block-end: calc(var(--spacing) * 3);
    scroll-margin-top: calc(var(--site-header-height, 4rem) + 2rem);
  }

  .markdown-content :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-block-end: calc(var(--spacing) * 4);
  }
  
  .markdown-content :global(ul) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-block-end: calc(var(--spacing) * 4);
    padding-inline-start: calc(var(--spacing) * 6);
  }

  .markdown-content :global(li) {
    margin-block-end: calc(var(--spacing) * 2);
  }
  
  .project-detail__footer {
    margin-block-start: calc(var(--spacing) * 16);
    padding-block-start: calc(var(--spacing) * 8);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    color: var(--color-text-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 64rem) {
    .project-detail__layout {
      flex-direction: row-reverse;
      align-items: flex-start;
    }

    .project-detail__metadata-area {
      flex: 1 1 35%;
      position: sticky;
      top: calc(var(--site-header-height, 4rem) + 2rem);
    }
    
    .metadata-grid {
      grid-template-columns: 1fr;
    }

    .project-detail__content-area {
      flex: 1 1 65%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('.lightbox-trigger');
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.querySelector('.lightbox-close');

    if (!lightbox || !(lightbox instanceof HTMLDialogElement)) return;

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-image-src');
        const alt = trigger.getAttribute('data-image-alt');
        
        if (lightboxImg instanceof HTMLImageElement) {
          lightboxImg.src = src || '';
          lightboxImg.alt = alt || '';
        }
        
        if (lightboxCaption) {
          lightboxCaption.textContent = alt || '';
        }
        
        lightbox.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    const closeModal = () => {
      lightbox.close();
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    
    // Close on backdrop click
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as Element).classList.contains('lightbox-content')) {
        closeModal();
      }
    });

    // Reset overflow when dialog closes (including via ESC key)
    lightbox.addEventListener('close', () => {
      document.body.style.overflow = '';
      setTimeout(() => {
        if (lightboxImg instanceof HTMLImageElement) {
          lightboxImg.src = ''; 
        }
      }, 200);
    });
  });
</script>
